# migrations/upstream/PIN — provenance of the vendored upstream migrations.
#
# Written by hand once per re-vendor (LUM-1386, W0-B); read by
# scripts/build_upstream_schema.py and scripts/schema_drift.py.  The directory is a
# read-only vendored copy: no file is renamed, reordered or edited, so the bytes here
# are exactly the bytes upstream ships.
#
# Do NOT re-vendor with a blob-less clone.  A full-blob shallow clone of this repo is
# 96 MB; measured wall clock on this box: 5.4 s and 21.9 s on two different runs
# (network dependent), after which grep is instant (0.010 s).  `git init` + `fetch
# --filter=blob:none` defers every blob fetch to first read (~1.4 s per object), which
# turns a single grep into a ~74 minute stall — it has wedged two earlier slices.
# Recipe and timings: docs/20-UPSTREAM-ANALYSIS-RECIPE.md §4.
#
# Verified twice: (a) `sha256sum -c MANIFEST.sha256` over the 560 vendored files, and
# (b) an independent `cmp` of every vendored file against
# `git fetch --depth 1 origin <commit>` in a fresh clone (see docs/25 §3.1).
repo: https://github.com/louloulin/multica
commit: f41fae6b08fb734afcbd13205c0b3203dd0bc9c6
branch: main
subdir: server/migrations
up_files: 560
down_files: 0
manifest: MANIFEST.sha256
generated_at: 2026-09-22T13:52:03+00:00
clone_command: git clone --depth 1 --single-branch --branch main https://github.com/louloulin/multica upstream-multica && git -C upstream-multica checkout --detach f41fae6b08fb734afcbd13205c0b3203dd0bc9c6
vendor_command: cp upstream-multica/server/migrations/*.up.sql migrations/upstream/ && (cd migrations/upstream && sha256sum *.up.sql > MANIFEST.sha256)
build_command: MULTICA_TEST_DATABASE_URL=postgres://multica:multica@127.0.0.1:5432/multica_test python3 scripts/build_upstream_schema.py
audit_command: cd migrations/upstream && sha256sum -c MANIFEST.sha256
