//! approvals 域。

use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use pc_core::Timestamp;

use crate::Db;

#[derive(Debug, Clone, FromRow, Serialize, Deserialize, PartialEq, Eq)]
pub struct Approval {
    pub id: Uuid,
    pub company_id: Uuid,
    pub title: String,
    pub status: String,
    pub requested_by_user_id: Option<String>,
    pub requested_by_agent_id: Option<Uuid>,
    pub decided_by_user_id: Option<String>,
    pub decided_at: Option<Timestamp>,
    pub created_at: Timestamp,
    pub updated_at: Timestamp,
}

pub struct ApprovalRepo<'a> {
    pub db: &'a Db,
}

impl<'a> ApprovalRepo<'a> {
    pub fn new(db: &'a Db) -> Self {
        Self { db }
    }

    pub async fn list_by_company(&self, company_id: Uuid) -> sqlx::Result<Vec<Approval>> {
        sqlx::query_as::<_, Approval>(
            "SELECT id, company_id, title, status, requested_by_user_id, requested_by_agent_id, \
             decided_by_user_id, decided_at, created_at, updated_at FROM approvals \
             WHERE company_id = $1 ORDER BY created_at DESC",
        )
        .bind(company_id)
        .fetch_all(self.db.pool())
        .await
    }
}
